{
  "registries": {
    "npmjs-public": {
      "type": "npm",
      "registry": "https://registry.npmjs.org",
      "token": "{{NPM_TOKEN}}",
      "access": "public",
      "enabled": true
    },

    "codeberg": {
      "type": "gitea",
      "url": "https://codeberg.org",
      "owner": "{{CODEBERG_OWNER}}",
      "token": "{{CODEBERG_TOKEN}}",
      "access": "public",
      "enabled": false
    },

    "github": {
      "type": "github",
      "owner": "{{GITHUB_OWNER}}",
      "repo": "{{GITHUB_REPO}}",
      "token": "{{GITHUB_TOKEN}}",
      "enabled": false
    },

    "gitea-selfhost": {
      "type": "gitea",
      "url": "{{GITEA_URL}}",
      "owner": "{{GITEA_OWNER}}",
      "token": "{{GITEA_TOKEN}}",
      "enabled": false
    },

    "supabase-backup": {
      "type": "supabase",
      "url": "{{SUPABASE_URL}}",
      "bucket": "{{SUPABASE_BUCKET}}",
      "serviceKey": "{{SUPABASE_SERVICE_KEY}}",
      "public": true,
      "enabled": false
    }
  },

  "build": {
    "command": null,
    "skipBuild": false
  },

  "npm": {
    "defaultArgs": ["--no-git-checks"],
    "customArgs": []
  }
}
