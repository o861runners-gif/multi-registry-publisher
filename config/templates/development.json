{
  "registries": {
    "verdaccio-local": {
      "type": "npm",
      "registry": "http://localhost:4873",
      "token": "{{VERDACCIO_TOKEN}}",
      "access": "public",
      "enabled": true
    }
  },

  "build": {
    "command": null,
    "skipBuild": true
  },

  "npm": {
    "defaultArgs": ["--no-git-checks"],
    "customArgs": []
  }
}
